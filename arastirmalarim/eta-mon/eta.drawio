        <mxCell id="uMuDDFjJFQ15Jn1OtVUi-14" value="#!/bin/bash&lt;br&gt;set -o pipefail&lt;br&gt;python3 /usr/share/pardus/pardus-lightdm-greeter/main.py&amp;nbsp; |&amp;amp; tee ~/pardus-lightdm-greeter.log&lt;br&gt;if [ $? -ne 0&amp;nbsp; ] ; then&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; python3 &amp;lt;&amp;lt;EOF&lt;br&gt;import gi, os&lt;br&gt;gi.require_version(&quot;Gtk&quot;, &quot;3.0&quot;)&lt;br&gt;from gi.repository import Gtk&lt;br&gt;w = Gtk.Window()&lt;br&gt;txt=open(os.environ[&quot;HOME&quot;]+&quot;/pardus-lightdm-greeter.log&quot;, &quot;r&quot;).read()&lt;br&gt;l=Gtk.Label(txt)&lt;br&gt;w.add(l)&lt;br&gt;w.show_all()&lt;br&gt;Gtk.main()&lt;br&gt;EOF&lt;br&gt;fi" style="rounded=0;whiteSpace=wrap;html=1;align=left;" parent="uMuDDFjJFQ15Jn1OtVUi-16" vertex="1">
          <mxGeometry y="21.04651162790698" width="530" height="263.08139534883725" as="geometry" />
        </mxCell>
        <mxCell id="uMuDDFjJFQ15Jn1OtVUi-15" value="source: /usr/libexec/pardus-lightdm-greeter" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="uMuDDFjJFQ15Jn1OtVUi-16" vertex="1">
          <mxGeometry width="470.23" height="21.04651162790698" as="geometry" />
        </mxCell>
        <mxCell id="uMuDDFjJFQ15Jn1OtVUi-18" value="/opt/logla.py altına kütüphane yerleştirdim. &lt;br&gt;&lt;br&gt;/opt yolunu /etc/environment dosyasında tanımladım.&lt;br&gt;&lt;br&gt;Temel kullanım şekli&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;from logla import logla&lt;/div&gt;logla(&#39;HATA&#39;, &#39;Bir hata oluştu&#39;)&lt;br&gt;&lt;br&gt;&lt;div&gt;log dosyası olarak /etc/var/eta.log dosyasını oluşturdum&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;okutalan qr kodlara tepkisi kalıyor, birden fazla kez okutulunca sonunda birikerek geliyor. Bir keresinde 3 kez peşpeşe geldi. Peşpeşe 3 kez sshlogin ebaqrebaqr çalıştı.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Mevcut kullanıcının oturumunu kapatmak için:&lt;br&gt;loginctl terminate-seat seat0&lt;br&gt;&lt;br&gt;Acilis kapanisi loglamak için bu servisi oluşturdum&lt;br&gt;nano /etc/systemd/system/acilis-kapanis-logla.service&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Greeter (main.py) log dosyası:&lt;br&gt;:/var/lib/lightdm/pardus-lightdm-greeter.log&lt;br&gt;&lt;br&gt;lighdm&#39;ın kullandığı yapılandırma dosyalarını görmek için:&lt;br&gt;&amp;nbsp;lightdm --show-config&lt;br&gt;&lt;br&gt;/usr/share/sifredegistir/passwordyetki&lt;br&gt;Bu araç suid bitli ve un pw syntax&#39;i ile parola sıfırlıyor&lt;br&gt;&lt;br&gt;&amp;nbsp;cat /var/lib/lightdm/pardus-lightdm-greeter.log&lt;br&gt;Greeter logları burada&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=17;" parent="1" vertex="1">
          <mxGeometry x="2120" y="-165" width="540" height="720" as="geometry" />
        </mxCell>
        <mxCell id="uMuDDFjJFQ15Jn1OtVUi-21" value="&lt;pre&gt;Yaygın olarak XFCE (DE - Desktop Environment) ile LighDM tercih edilir. &lt;br&gt;Hangi Display Manager (Oturum yöneticisi) kullanıldığını görmek için:&lt;/pre&gt;&lt;pre&gt;&lt;span class=&quot;token function&quot;&gt;cat&lt;/span&gt; /etc/X11/default-display-manager &lt;br&gt;&lt;br&gt;LightDM yöneticisinin yapılandırması /etc/lightdm&#39;den şuraya taşınmış:&lt;br&gt;/usr/share/lightdm/lightdm.conf.d&lt;br&gt;&lt;/pre&gt;" style="shape=note;strokeWidth=2;fontSize=14;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#666600;spacingTop=5;spacingLeft=5;spacingRight=5;spacingBottom=5;align=left;" parent="1" vertex="1">
          <mxGeometry x="650" y="-560" width="590" height="150" as="geometry" />
        </mxCell>
