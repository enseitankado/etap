        <mxCell id="1Rh0-Jpyivj9l5sKiZfh-41" value="#!/bin/bash&lt;br&gt;add_user()&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; user=&quot;$1&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; defpass=&quot;$user&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; pass=&quot;$2&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; if [ ! -d /home/$user ] ; then&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; useradd -m $user -s /bin/bash -p $(openssl passwd &quot;$pass&quot;) -U -d /home/$user&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; useradd $user-qr -s /bin/bash -p $(openssl passwd &quot;$defpass&quot;) -d /home/$user&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; mkdir -p /home/$user&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; chown $user -R /home/$user&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; chmod 755 /home/$user&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; uida=$(grep &quot;^$user:&quot; /etc/passwd | cut -f 3 -d &quot;:&quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; uidb=$(grep &quot;^$user-qr:&quot; /etc/passwd | cut -f 3 -d &quot;:&quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; sed -i &quot;s/:$uidb:/:$uida:/g&quot; /etc/passwd&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; for g in floppy audio video plugdev netdev $user; do usermod -aG $g $user-qr || true;usermod -aG $g $user || true;done&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; #usermod $user-qr -p $(openssl passwd -6 &quot;$pass&quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp; fi&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;align=left;fontFamily=Courier New;spacingLeft=19;" parent="1" vertex="1">
          <mxGeometry x="700" y="650" width="920" height="290" as="geometry" />
        </mxCell>
